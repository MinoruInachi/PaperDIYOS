{
  "name": "micropython",
  "version": "1.29.0",
  "description": "MicroPython embed port generated by tools/setup_micropython.sh plus the PaperDIY port layer.",
  "frameworks": ["arduino"],
  "platforms": "espressif32",
  "build": {
    "includeDir": "port",
    "srcDir": ".",
    "srcFilter": ["+<embed/py/*.c>", "+<embed/extmod/*.c>", "+<embed/shared/**/*.c>", "+<port/*.c>"],
    "flags": ["-I port", "-I embed", "-Wno-unused-function", "-Wno-missing-field-initializers"]
  }
}
