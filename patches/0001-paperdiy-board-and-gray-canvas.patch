diff --git a/libs/hardware/BoardPaperDiy/include/BoardPaperDiy.h b/libs/hardware/BoardPaperDiy/include/BoardPaperDiy.h
new file mode 100644
index 0000000..c950b37
--- /dev/null
+++ b/libs/hardware/BoardPaperDiy/include/BoardPaperDiy.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <Arduino.h>
+
+// M5Stack PaperDIY pin map: the parallel-EPD bus plus what the BoardProfile has no
+// field for. Sources: schematic K159-B, M5GFX autodetect (board_M5PaperDIY).
+
+#define PAPERDIY_EP_D0 6
+#define PAPERDIY_EP_D1 14
+#define PAPERDIY_EP_D2 7
+#define PAPERDIY_EP_D3 12
+#define PAPERDIY_EP_D4 9
+#define PAPERDIY_EP_D5 11
+#define PAPERDIY_EP_D6 8
+#define PAPERDIY_EP_D7 10
+#define PAPERDIY_EP_SPH 13  // XSTL
+#define PAPERDIY_EP_CL 16   // XCL
+#define PAPERDIY_EP_LE 15   // XLE
+#define PAPERDIY_EP_SPV 17
+#define PAPERDIY_EP_CKV 18
+#define PAPERDIY_EP_OE 45   // as M5GFX. Also EXT_G45 (MCLK) on the I2S FPC
+#define PAPERDIY_EP_PWR 46  // BST_EN: boost enable, sequenced by Bus_EPD
+
+#define PAPERDIY_KEY_A 4    // KEY1, active low, wakes from deep sleep
+#define PAPERDIY_KEY_B 3    // KEY2, active low, wakes from deep sleep
+#define PAPERDIY_SD_DET 48  // card detect
+
+namespace BoardPaperDiy {
+
+constexpr uint8_t PM1_GPIO_EPD_PWR = 2;
+constexpr uint8_t PM1_GPIO_CHG_STAT = 3;
+
+// EPD_PWR on M5PM1 GPIO2. Must be up before the panel is driven; dropped before
+// deep sleep (the PMIC stays powered, so it would otherwise stay on).
+bool setEpdRail(bool on);
+
+// LOW on M5PM1 GPIO3 means the LGS4056H is charging.
+bool isCharging();
+
+// Boot power policy: charger enabled, PMIC watchdog and I2C idle sleep off.
+void applyBootPower();
+
+// PMIC shutdown (the "L1 Standby" mode). Only the power button brings it back.
+void powerOff();
+
+}  // namespace BoardPaperDiy
