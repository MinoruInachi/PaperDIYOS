diff --git a/libs/hardware/BoardPaperDiy/src/BoardPaperDiy.cpp b/libs/hardware/BoardPaperDiy/src/BoardPaperDiy.cpp
new file mode 100644
index 0000000..46d049d
--- /dev/null
+++ b/libs/hardware/BoardPaperDiy/src/BoardPaperDiy.cpp
@@ -0,0 +1,73 @@
+#include <BoardPaperDiy.h>
+#include <LgfxEpdConfig.h>
+#include <M5Pm1.h>
+
+namespace pm1 = freeink::m5pm1;
+
+namespace BoardPaperDiy {
+
+bool setEpdRail(bool on) {
+  pm1::beginBus();
+  const uint8_t mask = 1u << PM1_GPIO_EPD_PWR;
+  // Plain GPIO function (two bits per pin), push-pull output. Same writes as M5GFX.
+  if (!pm1::updateReg(pm1::REG_GPIO_FUNC0, 0b11 << (2 * PM1_GPIO_EPD_PWR), 0)) return false;
+  if (!pm1::updateReg(pm1::REG_GPIO_MODE, 0, mask)) return false;
+  if (!pm1::updateReg(pm1::REG_GPIO_DRV, mask, 0)) return false;
+  if (!pm1::updateReg(pm1::REG_GPIO_OUT, on ? 0 : mask, on ? mask : 0)) return false;
+  delay(10);
+  return true;
+}
+
+bool isCharging() {
+  pm1::beginBus();
+  const uint8_t mask = 1u << PM1_GPIO_CHG_STAT;
+  pm1::updateReg(pm1::REG_GPIO_FUNC0, 0b11 << (2 * PM1_GPIO_CHG_STAT), 0);
+  pm1::updateReg(pm1::REG_GPIO_MODE, mask, 0);
+  uint8_t in = 0xFF;
+  // REG_GPIO_IN sits right after REG_GPIO_OUT in the PM1 register map.
+  if (!pm1::readReg(pm1::REG_GPIO_OUT + 1, &in)) return false;
+  return (in & mask) == 0;
+}
+
+void applyBootPower() {
+  pm1::beginBus();
+  // PWR_CFG auto-clears on reset. CHG_EN keeps the LGS4056H charging over USB; the
+  // other rail bits are left as the PMIC has them.
+  pm1::updateReg(pm1::REG_PWR_CFG, 0, pm1::CHG_EN);
+}
+
+void powerOff() {
+  pm1::beginBus();
+  pm1::requestShutdown();
+}
+
+}  // namespace BoardPaperDiy
+
+namespace {
+
+bool prepareEpdPower() { return BoardPaperDiy::setEpdRail(true); }
+
+}  // namespace
+
+namespace freeink {
+
+const LgfxEpdConfig& m5PaperDiyLgfxConfig() {
+  static const LgfxEpdConfig cfg = {
+      {PAPERDIY_EP_D0, PAPERDIY_EP_D1, PAPERDIY_EP_D2, PAPERDIY_EP_D3, PAPERDIY_EP_D4, PAPERDIY_EP_D5, PAPERDIY_EP_D6,
+       PAPERDIY_EP_D7},
+      PAPERDIY_EP_SPH,
+      PAPERDIY_EP_SPV,
+      PAPERDIY_EP_OE,
+      PAPERDIY_EP_LE,
+      PAPERDIY_EP_CL,
+      PAPERDIY_EP_CKV,
+      PAPERDIY_EP_PWR,
+      16000000,  // M5GFX bus_speed for this board
+      8,         // M5GFX line_padding for this board
+      0,         // native landscape; FrameRotation::Portrait equals M5GFX offset_rotation=3
+      {&prepareEpdPower, nullptr, nullptr},  // stock Bus_EPD sequence for OE/BST_EN/SPV
+  };
+  return cfg;
+}
+
+}  // namespace freeink
